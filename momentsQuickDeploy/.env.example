# 程序监听地址和端口
HOST=0.0.0.0
PORT=9889

# 运行环境：生产环境必须设置为 production，否则会额外放行本地调试来源
NODE_ENV=development

# 密钥（必须修改！生产环境使用占位值或长度不足 32 位会直接拒绝启动）
# 生成方式：openssl rand -hex 32
JWT_SECRET=demo_jwt_secret
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_SECONDS=2592000

# 可信反向代理跳数。默认不信任任何代理（X-Forwarded-For 不会被采信）。
# 部署在 Nginx / OpenResty 等反向代理之后时，按真实跳数填写，例如 1；
# 直接对外暴露端口时保持注释，避免客户端伪造 X-Forwarded-For 篡改 req.ip。
# TRUST_PROXY=1

# HttpOnly refresh token Cookie；默认根据请求是否真正走 HTTPS 自动判断
# AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# 跨域部署时填写允许携带凭证的前端 Origin，多个值用英文逗号分隔
CORS_ORIGINS=http://localhost:5173

# MySQL数据库配置
DATABASE_URL="mysql://root:123456@127.0.0.1:3306/moment"
