# 程序监听地址和端口
HOST=0.0.0.0
PORT=9889

# 生产环境标识，会影响 CORS 可信来源判定与密钥强度校验
NODE_ENV=production

# JWT 密钥不在此处配置：
# 容器启动脚本会在首次运行时自动生成随机密钥并持久化到 moments_data 卷，
# 你也可以通过 docker compose 的 environment 或服务器上的环境变量显式覆盖它。
# 手动指定时请使用足够强的随机值：openssl rand -hex 32
JWT_ACCESS_EXPIRES_SECONDS=7200
JWT_REFRESH_EXPIRES_SECONDS=2592000

# 容器直接对外暴露端口，没有反向代理，因此不信任 X-Forwarded-For
TRUST_PROXY=false

# MySQL 配置（host=db 为 docker-compose 中的 mysql 服务名）
DATABASE_URL="mysql://demo:demo@db:3306/demo"
