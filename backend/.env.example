# 程序监听地址和端口
HOST=0.0.0.0
PORT=9889

# 密钥（越复杂越好）
JWT_SECRET=demo_jwt_secret
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_SECONDS=2592000

# HttpOnly refresh token Cookie；默认根据请求是否为 HTTPS 设置 Secure，可按需覆盖
# AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# 跨域部署时填写允许携带凭证的前端 Origin，多个值用英文逗号分隔
CORS_ORIGINS=http://localhost:5173

# MySQL数据库配置
DATABASE_URL="mysql://root:123456@127.0.0.1:3306/moment"
